<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HongguoTV.Desktop.ViewModels"
        xmlns:core="using:HongguoTV.Core"
        xmlns:views="using:HongguoTV.Desktop.Views"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        x:Class="HongguoTV.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:FieldModifier="public"
        Title="红果 TV · Windows" Width="1280" Height="780" MinWidth="960" MinHeight="600"
        Icon="/Assets/app.ico"
        Background="#0E141D" Foreground="#E6EDF3"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None">
    <Window.Resources>
        <DataTemplate x:Key="SeriesCard" DataType="vm:SeriesViewModel">
            <Button Classes="series-card" Background="Transparent" BorderThickness="0" Padding="0"
                    Command="{Binding OpenCommand}" Cursor="Hand" Width="176" Margin="0,0,18,16">
                <StackPanel>
                    <Border CornerRadius="10" ClipToBounds="True" Background="#1C2431">
                        <views:AsyncImage Url="{Binding Cover}" Height="228" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Margin="10,8,6,0">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxLines="2" Height="36" />
                        <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="#8B98A9"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="HistoryCard" DataType="vm:HistoryViewModel">
            <Button Classes="series-card" Background="Transparent" BorderThickness="0" Padding="0"
                    Command="{Binding OpenCommand}" Cursor="Hand" Width="176" Margin="0,0,18,16">
                <StackPanel>
                    <Border CornerRadius="10" ClipToBounds="True" Background="#1C2431">
                        <views:AsyncImage Url="{Binding Cover}" Height="228" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Margin="10,8,6,0">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxLines="2" Height="36" />
                        <TextBlock Text="{Binding Progress}" FontSize="11" Foreground="#8B98A9"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <Border x:Name="NavBar" Grid.Row="0" Background="#141C27" Padding="22,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="红果 TV" FontSize="20" FontWeight="Bold" Foreground="#FF6B6B" />
                    <TextBlock Text="Windows" FontSize="12" Foreground="#7D8B9B" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                    <Button Classes="nav" Command="{Binding HomeCommand}" Padding="14,7" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconNavHome}" Stroke="#D8DEE9" StrokeThickness="1.7"
                                  StrokeLineCap="Round" StrokeJoin="Round" Width="17" Height="17"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="推荐" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Command="{Binding SearchCommand}" Padding="14,7" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconNavSearch}" Stroke="#D8DEE9" StrokeThickness="1.7"
                                  StrokeLineCap="Round" StrokeJoin="Round" Width="17" Height="17"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="搜索" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Command="{Binding FavoritesCommand}" Padding="14,7" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconNavStar}" Stroke="#D8DEE9" StrokeThickness="1.7"
                                  StrokeLineCap="Round" StrokeJoin="Round" Width="17" Height="17"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="收藏" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Command="{Binding HistoryCommand}" Padding="14,7" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconNavHistory}" Stroke="#D8DEE9" StrokeThickness="1.7"
                                  StrokeLineCap="Round" StrokeJoin="Round" Width="17" Height="17"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="历史" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Command="{Binding SettingsCommand}" Padding="14,7" Cursor="Hand"
                            ToolTip.Tip="设置">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconNavSettings}" Stroke="#D8DEE9" StrokeThickness="1.7"
                                  StrokeLineCap="Round" StrokeJoin="Round" Width="17" Height="17"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="设置" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#7D8B9B"
                               MaxWidth="240" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <Button x:Name="MinimizeButton" Click="WindowButton_Click" Width="32" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTip.Tip="最小化"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Path Data="{StaticResource IconMinimize}" Fill="#B9C4D1" Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="MaximizeButton" Click="WindowButton_Click" Width="32" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTip.Tip="最大化 / 还原"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" Fill="#B9C4D1" Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="CloseButton" Click="WindowButton_Click" Width="32" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTip.Tip="关闭"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Path Data="{StaticResource IconClose}" Fill="#B9C4D1" Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="BackBar" Grid.Row="1" Background="#0E141D" Padding="22,12,22,0" IsVisible="{Binding DetailOpen}">
            <Button Classes="nav" Content="← 返回" Command="{Binding BackCommand}" />
        </Border>

        <Grid x:Name="ContentArea" Grid.Row="2" Margin="22,8,22,12">
            <ScrollViewer IsVisible="{Binding !DetailOpen}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel IsVisible="{Binding Page, Converter={x:Static vm:PageConverters.IsSearch}}">
                        <TextBox Classes="search" Text="{Binding SearchText}" PlaceholderText="输入剧名搜索，支持联想词"
                                 Height="44" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Spacing="8">
                            <Button Content="搜索" Command="{Binding SearchNowCommand}" Width="88" Background="#E5484D" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Margin="0,0,8,8" Padding="10,5" FontSize="12"
                                            Background="#18212E" Foreground="#B9C4D1" CornerRadius="14" Cursor="Hand"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SuggestionClickCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="section" Text="搜索结果" />
                    </StackPanel>

                    <TextBlock Classes="section" Text="热门推荐" IsVisible="{Binding Page, Converter={x:Static vm:PageConverters.IsHome}}" />
                    <TextBlock Classes="section" Text="我的收藏" IsVisible="{Binding Page, Converter={x:Static vm:PageConverters.IsFavorites}}" />
                    <TextBlock Classes="section" Text="观看历史" IsVisible="{Binding Page, Converter={x:Static vm:PageConverters.IsHistory}}" />

                    <ItemsControl ItemsSource="{Binding HomeItems}" IsVisible="{Binding Page, Converter={x:Static vm:PageConverters.IsHome}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SeriesCard}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding SearchItems}" IsVisible="{Binding Page, Converter={x:Static vm:PageConverters.IsSearch}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SeriesCard}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Favorites}" IsVisible="{Binding Page, Converter={x:Static vm:PageConverters.IsFavorites}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SeriesCard}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding History}" IsVisible="{Binding Page, Converter={x:Static vm:PageConverters.IsHistory}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HistoryCard}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="加载更多" Command="{Binding LoadMoreCommand}" Margin="0,16,0,0" HorizontalAlignment="Center"
                            IsVisible="{Binding Page, Converter={x:Static vm:PageConverters.IsPaged}}" />
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="DetailGrid" IsVisible="{Binding DetailOpen}" ColumnDefinitions="200,480,*">
                <StackPanel Margin="0,0,18,0">
                    <views:AsyncImage Url="{Binding Cover}" Height="306" Stretch="UniformToFill" />
                    <Button Content="{Binding IsFavorite, Converter={x:Static vm:PageConverters.FavoriteText}}"
                            Command="{Binding ToggleFavoriteCommand}" Margin="0,12,0,0" HorizontalAlignment="Stretch" />
                </StackPanel>
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="4,0,12,0">
                    <StackPanel>
                        <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="10">
                            <TextBlock Text="{Binding Badge}" Foreground="#FF8A8A" FontSize="12" IsVisible="{Binding Badge.Length}" />
                            <TextBlock Text="{Binding Tags}" Foreground="#8B98A9" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Foreground="#9BA8B8" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="68" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,14,0,8">
                        <TextBlock Classes="section" Text="选集" Margin="0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding Episodes}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:EpisodeViewModel">
                                    <Button Content="{Binding Label}" Command="{Binding PlayCommand}" Width="72" Margin="0,0,8,8"
                                            Background="{Binding Playing, Converter={x:Static vm:PageConverters.PlayingBackground}}"
                                            Foreground="#DCE4EE" CornerRadius="8" FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Border x:Name="PlayerBorder" Grid.Column="2" Background="#070A0F" CornerRadius="10" ClipToBounds="True">
                    <Grid RowDefinitions="*,Auto">
                        <vlc:VideoView x:Name="PlayerView" Grid.Row="0" />
                        <Border Grid.Row="1" Background="#141C27" Padding="10,8">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
                                <Button Grid.Column="0" Command="{Binding PlayPauseCommand}" Width="36" Height="30"
                                        ToolTip.Tip="播放 / 暂停">
                                    <Panel>
                                        <Path Data="{StaticResource IconPlay}" Fill="#E6EDF3" Width="14" Height="14"
                                              Stretch="Uniform" IsVisible="{Binding !IsPlaying}" />
                                        <Path Data="{StaticResource IconPause}" Fill="#E6EDF3" Width="14" Height="14"
                                              Stretch="Uniform" IsVisible="{Binding IsPlaying}" />
                                    </Panel>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding StopCommand}" Width="36" Height="30" Margin="6,0,0,0"
                                        ToolTip.Tip="停止">
                                    <Path Data="{StaticResource IconStop}" Fill="#E6EDF3" Width="13" Height="13" Stretch="Uniform" />
                                </Button>
                                <TextBlock Grid.Column="2" Text="清晰度" Foreground="#8B98A9" FontSize="11" VerticalAlignment="Center" Margin="14,0,4,0" />
                                <ComboBox Grid.Column="3" SelectedIndex="{Binding MaxQualityIndex}" Width="86" FontSize="11">
                                    <ComboBoxItem Content="480P" />
                                    <ComboBoxItem Content="720P" />
                                    <ComboBoxItem Content="1080P" />
                                    <ComboBoxItem Content="2160P" />
                                </ComboBox>
                                <TextBlock Grid.Column="4" Text="倍速" Foreground="#8B98A9" FontSize="11" VerticalAlignment="Center" Margin="10,0,4,0" />
                                <ComboBox Grid.Column="5" SelectedIndex="{Binding SpeedIndex}" Width="68" FontSize="11">
                                    <ComboBoxItem Content="0.75x" />
                                    <ComboBoxItem Content="1.0x" />
                                    <ComboBoxItem Content="1.25x" />
                                    <ComboBoxItem Content="1.5x" />
                                    <ComboBoxItem Content="2.0x" />
                                </ComboBox>
                                <TextBlock Grid.Column="6" Text="{Binding Quality}" Foreground="#5F6B7A" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <CheckBox Grid.Column="7" Content="自动连播" IsChecked="{Binding AutoPlay}"
                                          FontSize="11" Foreground="#B9C4D1" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <Button x:Name="FullScreenButton" Grid.Column="8" Click="FullScreenButton_Click"
                                        Width="36" Height="30" Margin="6,0,0,0" ToolTip.Tip="播放器全屏（ESC 退出）">
                                    <Path x:Name="FullScreenIcon" Data="{StaticResource IconFullscreen}"
                                          Fill="#E6EDF3" Width="14" Height="14" Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 设置对话框（应用内遮罩层） -->
        <Border Grid.Row="0" Grid.RowSpan="3" ZIndex="100" Background="#B3000000"
                IsVisible="{Binding SettingsOpen}">
            <Border Background="#161F2B" BorderBrush="#2A3546" BorderThickness="1" CornerRadius="14"
                    Width="460" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="设置" FontSize="18" FontWeight="Bold" />
                    <Border Height="1" Background="#2A3546" />
                    <TextBlock Text="视频解码" FontSize="13" Foreground="#8B98A9" />
                    <RadioButton GroupName="DecodeMode" IsChecked="{Binding UseGpuDecode}" Foreground="#D8DEE9">
                        <StackPanel Spacing="2">
                            <TextBlock Text="GPU 硬件解码（D3D11VA）" FontSize="13" />
                            <TextBlock Text="占用 CPU 少，默认选项。老显卡解 1080P HEVC 可能花屏或卡顿。"
                                       FontSize="11" Foreground="#7D8B9B" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="DecodeMode" IsChecked="{Binding UseCpuDecode}" Foreground="#D8DEE9">
                        <StackPanel Spacing="2">
                            <TextBlock Text="CPU 软件解码" FontSize="13" />
                            <TextBlock Text="兼容性最好，画面异常时改用它；高分辨率对 CPU 要求较高。"
                                       FontSize="11" Foreground="#7D8B9B" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Text="解码方式在下一次开始播放时生效。" FontSize="11" Foreground="#5F6B7A" />
                    <Button Content="完成" Command="{Binding CloseSettingsCommand}" Width="92"
                            HorizontalAlignment="Right" Background="#E5484D" Foreground="#FFFFFF" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
