<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HongguoTV.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,10" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#D8DEE9" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A3444" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1C2431" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#2A3546" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.search">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="#151C27" />
        </Style>
    </Application.Styles>
</Application>
