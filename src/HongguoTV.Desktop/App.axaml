<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HongguoTV.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <StreamGeometry x:Key="IconPlay">M 8,5 L 19,12 L 8,19 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPause">M 6,5 L 10,5 L 10,19 L 6,19 Z M 14,5 L 18,5 L 18,19 L 14,19 Z</StreamGeometry>
        <StreamGeometry x:Key="IconStop">M 6,6 L 18,6 L 18,18 L 6,18 Z</StreamGeometry>
        <StreamGeometry x:Key="IconFullscreen">M 4,9 L 4,4 L 9,4 L 9,6 L 6,6 L 6,9 Z M 15,4 L 20,4 L 20,9 L 18,9 L 18,6 L 15,6 Z M 4,15 L 6,15 L 6,18 L 9,18 L 9,20 L 4,20 Z M 18,15 L 20,15 L 20,20 L 15,20 L 15,18 L 18,18 Z</StreamGeometry>
        <StreamGeometry x:Key="IconFullscreenExit">M 9,4 L 9,9 L 4,9 L 4,7 L 7,7 L 7,4 Z M 15,4 L 18,4 L 18,7 L 20,7 L 20,9 L 15,9 Z M 4,15 L 9,15 L 9,20 L 7,20 L 7,17 L 4,17 Z M 15,15 L 20,15 L 20,17 L 17,17 L 17,20 L 15,20 Z</StreamGeometry>
        <StreamGeometry x:Key="IconMinimize">M 5,9.5 L 15,9.5 L 15,10.5 L 5,10.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconMaximize">M 5,5 L 15,5 L 15,15 L 5,15 Z M 6.5,6.5 L 13.5,6.5 L 13.5,13.5 L 6.5,13.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconRestore">M 7,7 L 14,7 L 14,14 L 7,14 Z M 5,5 L 12,5 L 12,6 L 6,6 L 6,12 L 5,12 Z</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M 5,5 L 6.2,5 L 10,8.8 L 13.8,5 L 15,5 L 15,6.2 L 11.2,10 L 15,13.8 L 15,15 L 13.8,15 L 10,11.2 L 6.2,15 L 5,15 L 5,13.8 L 8.8,10 L 5,6.2 Z</StreamGeometry>
        <StreamGeometry x:Key="IconNavHome">M 3.5,11 L 12,4 L 20.5,11 M 5.5,9.5 L 5.5,20 L 18.5,20 L 18.5,9.5</StreamGeometry>
        <StreamGeometry x:Key="IconNavSearch">M 11,4.5 A 6.5,6.5 0 1 0 11,17.5 A 6.5,6.5 0 1 0 11,4.5 M 15.6,15.6 L 20,20</StreamGeometry>
        <StreamGeometry x:Key="IconNavStar">M 12,3.5 L 14.7,9.2 L 21,10.1 L 16.5,14.5 L 17.6,20.8 L 12,17.9 L 6.4,20.8 L 7.5,14.5 L 3,10.1 L 9.3,9.2 Z</StreamGeometry>
        <StreamGeometry x:Key="IconNavHistory">M 12,3.5 A 8.5,8.5 0 1 0 11.999,3.5 M 12,7.5 L 12,12.2 L 16,14.5</StreamGeometry>
        <StreamGeometry x:Key="IconNavSettings">M 3.5,7 L 20.5,7 M 14.8,4.6 L 14.8,9.4 M 3.5,12 L 20.5,12 M 9,9.6 L 9,14.4 M 3.5,17 L 20.5,17 M 17,14.6 L 17,19.4</StreamGeometry>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,10" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#D8DEE9" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A3444" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1C2431" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#2A3546" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- 剧集卡片：悬停放大，不改变背景色 -->
        <Style Selector="Button.series-card">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.series-card:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.series-card:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="TextBox.search">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="#151C27" />
        </Style>
        <Style Selector="Button#CloseButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
        </Style>
        <Style Selector="Button#CloseButton:pointerover Path">
            <Setter Property="Fill" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button#MinimizeButton:pointerover /template/ ContentPresenter, Button#MaximizeButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A3444" />
        </Style>
    </Application.Styles>
</Application>
